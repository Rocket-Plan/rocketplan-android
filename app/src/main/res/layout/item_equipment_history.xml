<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/historyQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/main_purple"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            tools:text="2 units" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/historyDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/light_text_rp"
            android:textSize="@dimen/text_size_caption"
            tools:text="Jan 30, 2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dark_text_rp"
        android:textSize="@dimen/text_size_body"
        android:visibility="gone"
        tools:text="Moved to drying room" />

    <TextView
        android:id="@+id/historyRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/light_text_rp"
        android:textSize="@dimen/text_size_caption"
        tools:text="Room 101 → Room 203" />

</LinearLayout>