<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Content (mode ON) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/serializedContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/serializedRoomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_text_rp"
                android:textSize="@dimen/text_size_card_title"
                android:textStyle="bold"
                tools:text="Basement" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/serializedRegisterButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/serialized_equipment_register_cta"
                app:cornerRadius="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/serialized_equipment_deployed_header"
                android:textColor="@color/main_purple"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/serializedDeployedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_serialized_equipment" />

            <TextView
                android:id="@+id/serializedDeployedEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/serialized_equipment_deployed_empty"
                android:textColor="@color/light_text_rp"
                android:textSize="@dimen/text_size_caption"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/serialized_equipment_pool_header"
                android:textColor="@color/main_purple"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/serializedPoolList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_serialized_equipment" />

            <TextView
                android:id="@+id/serializedPoolEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/serialized_equipment_pool_empty"
                android:textColor="@color/light_text_rp"
                android:textSize="@dimen/text_size_caption"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/serializedLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- Retry (mode UNKNOWN) -->
    <LinearLayout
        android:id="@+id/serializedRetry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/serialized_equipment_unavailable"
            android:textColor="@color/light_text_rp"
            android:textSize="@dimen/text_size_body_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/serializedRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            app:cornerRadius="16dp" />
    </LinearLayout>

</FrameLayout>
