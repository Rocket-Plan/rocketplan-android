<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/transferProjectInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/equipment_room_transfer_project"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/transferProjectInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:dropDownVerticalOffset="8dp"
            android:textColor="@color/dark_text_rp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/transferRoomInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/equipment_room_transfer_room"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/transferRoomInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:dropDownVerticalOffset="8dp"
            android:textColor="@color/dark_text_rp" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/transferLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/equipment_room_units"
            android:textColor="@color/dark_text_rp"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/transferQuantityMinus"
            android:layout_width="@dimen/icon_size_action"
            android:layout_height="@dimen/icon_size_action"
            android:background="@drawable/bg_icon_circle_light"
            android:contentDescription="@string/rocketdry_remove"
            android:padding="10dp"
            android:src="@drawable/icon_xmark"
            android:tint="@color/main_purple" />

        <TextView
            android:id="@+id/transferQuantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:textColor="@color/dark_text_rp"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:text="1" />

        <ImageButton
            android:id="@+id/transferQuantityPlus"
            android:layout_width="@dimen/icon_size_action"
            android:layout_height="@dimen/icon_size_action"
            android:background="@drawable/bg_icon_circle_purple"
            android:contentDescription="@string/rocketdry_add"
            android:padding="10dp"
            android:src="@drawable/icon_circle_plus"
            android:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/transferQuantityHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/light_text_rp"
        android:textSize="@dimen/text_size_caption"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/transferNoteInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/equipment_room_note_optional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/transferNoteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textColor="@color/dark_text_rp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equipment_room_dialog_cancel"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transferSave"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/equipment_room_transfer_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/main_purple" />
    </LinearLayout>
</LinearLayout>